# Discord (Developer Portal)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Onde o arquivo SQLite fica. No Railway use o caminho do Volume, ex.: /data
DATA_DIR=./data

# Painel web (opcional). Só liga se as três variáveis abaixo existirem.
# PANEL_BASE_URL é a URL pública do serviço, sem barra no final.
PANEL_BASE_URL=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=

# O Railway define PORT sozinho
PORT=3000
